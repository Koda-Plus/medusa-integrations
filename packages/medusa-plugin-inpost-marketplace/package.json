{
  "name": "@koda-plus/medusa-plugin-inpost-marketplace",
  "version": "0.1.0",
  "description": "InPost Von Halsky by Koda Plus: the InPost marketplace (InPost Von Halsky, also called InPost Buy) for Medusa. Variants become marketplace offers matched by EAN, brand and manufacturer part number with GPSR manufacturer data, priced with a channel markup and stocked from Medusa inventory; marketplace orders are imported as Medusa orders paid by the marketplace, and tracking numbers go back. Demo mode runs every step on the store catalog without calling anything outside; the live seller API waits for the integrator agreement.",
  "author": {
    "name": "Koda Plus",
    "email": "kontakt@koda.plus",
    "url": "https://koda.plus"
  },
  "license": "MIT",
  "homepage": "https://github.com/Koda-Plus/medusa-integrations/tree/main/packages/medusa-plugin-inpost-marketplace#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koda-Plus/medusa-integrations.git",
    "directory": "packages/medusa-plugin-inpost-marketplace"
  },
  "bugs": {
    "url": "https://github.com/Koda-Plus/medusa-integrations/issues"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-plugin",
    "medusa",
    "inpost",
    "von-halsky",
    "inpost-marketplace",
    "marketplace",
    "gpsr",
    "poland"
  ],
  "files": [
    ".medusa/server",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "test": "node --experimental-strip-types --no-warnings --import ./test/ts-resolve.mjs --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "prepublishOnly": "npm test && npm run typecheck && medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.15.3",
