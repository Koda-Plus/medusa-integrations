{
  "name": "@koda-plus/medusa-plugin-olx",
  "version": "0.1.0",
  "description": "OLX by Koda Plus: connect an OLX seller account to Medusa, import its adverts and link them to products by SKU. Read-only, encrypted tokens, demo mode.",
  "author": {
    "name": "Koda Plus",
    "email": "kontakt@koda.plus",
    "url": "https://koda.plus"
  },
  "license": "MIT",
  "homepage": "https://github.com/Koda-Plus/medusa-plugin-olx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Koda-Plus/medusa-plugin-olx.git"
  },
  "bugs": {
    "url": "https://github.com/Koda-Plus/medusa-plugin-olx/issues"
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-plugin",
    "medusa",
    "olx",
    "olx-partner-api",
    "marketplace",
    "classifieds",
    "oauth2"
  ],
  "files": [
    ".medusa/server",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/admin/tsconfig.json",
    "prepublishOnly": "npm test && medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.15.3",
    "@medusajs/cli": "2.15.3",
    "@medusajs/framework": "2.15.3",
    "@medusajs/icons": "2.15.3",
    "@medusajs/medusa": "2.15.3",
    "@medusajs/test-utils": "2.15.3",
    "@medusajs/ui": "4.1.13",
    "@swc/core": "^1.15.0",
    "@tanstack/react-query": "^5.64.2",
    "@types/node": "^22.5.4",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^13.5.0",
    "react-router-dom": "^6.30.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.0",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.12.0",
    "@medusajs/framework": "^2.12.0",
    "@medusajs/icons": "^2.12.0",
    "@medusajs/medusa": "^2.12.0",
    "@medusajs/ui": "^4.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-i18next": ">=13.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
